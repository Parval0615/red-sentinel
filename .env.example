AI_SYSTEM_ROOT=D:\AI-System
LLM_API_BASE=https://api-inference.modelscope.cn/v1
LLM_API_KEY=
LLM_MODEL=Qwen/Qwen3.5-35B-A3B
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# OpenManus W2 real-runtime configuration (SiliconFlow OpenAI-compatible API).
# Put the real key only in the ignored local .env file or export it in your shell.
# Use the API base path, not the /chat/completions endpoint, because the client appends it.
OPENAI_API_KEY=replace-with-local-siliconflow-key
OPENAI_BASE_URL=https://api.siliconflow.cn/v1
OPENAI_MODEL=deepseek-ai/DeepSeek-V4-Flash
